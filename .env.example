NUXT_SITE_URL="https://clasteria.pixelsia.net"
NUXT_SITE_NAME="Clasteria"
NUXT_PUBLIC_MAINTENANCE_URL="https://pixelsia.net/"

# Local static editor preview only. Pages branch previews enable it automatically.
# Never enabled on the Cloudflare Pages main branch.
NUXT_VISUAL_EDITOR=false

# Server-only Pages PREVIEW runtime settings, configured in Cloudflare after approval.
# Do not add these to Nuxt public runtimeConfig. Never commit an Access token.
# CLASTERIA_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
# CLASTERIA_ACCESS_AUD=<existing-preview-application-audience>
# CLASTERIA_EDITOR_ALLOWED_EMAILS=<approved-editor-email>
# CLASTERIA_DRAFTS is a D1 binding, not an environment-string credential.
